# ============================================
# CPCM Analytics Dashboard — Environment Variables
# Copy this file to .env and set values for production
# ============================================

# NextAuth secret — MUST be set in production
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.dnhkwqponpgkhrbycehl.supabase.co:5432/postgres

# Backend API URL — as seen from the USER'S BROWSER
NEXT_PUBLIC_BACKEND_URL=http://110.239.80.161:8000

# Default admin user (used by seed script on first run)
SEED_USER_EMAIL=admin@cpcm.com
SEED_USER_PASSWORD=admin123
SEED_USER_NAME=Admin
